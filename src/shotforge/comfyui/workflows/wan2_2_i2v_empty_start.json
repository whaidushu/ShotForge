{
  "10": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1,
      "color": 2105376
    }
  },
  "84": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{clip_name}}",
      "type": "wan",
      "device": "default"
    }
  },
  "90": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{vae_name}}"
    }
  },
  "95": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{high_noise_unet}}",
      "weight_dtype": "default"
    }
  },
  "96": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{low_noise_unet}}",
      "weight_dtype": "default"
    }
  },
  "101": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["95", 0],
      "lora_name": "{{high_noise_lora}}",
      "strength_model": 1.0
    }
  },
  "102": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["96", 0],
      "lora_name": "{{low_noise_lora}}",
      "strength_model": 1.0
    }
  },
  "104": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["101", 0],
      "shift": 5.0
    }
  },
  "103": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["102", 0],
      "shift": 5.0
    }
  },
  "93": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["84", 0],
      "text": "{{prompt}}"
    }
  },
  "89": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["84", 0],
      "text": "{{negative_prompt}}"
    }
  },
  "98": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["93", 0],
      "negative": ["89", 0],
      "vae": ["90", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{length}}",
      "batch_size": 1,
      "start_image": ["10", 0]
    }
  },
  "86": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["104", 0],
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["98", 0],
      "negative": ["98", 1],
      "latent_image": ["98", 2],
      "start_at_step": 0,
      "end_at_step": 2,
      "return_with_leftover_noise": "enable"
    }
  },
  "85": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["103", 0],
      "add_noise": "disable",
      "noise_seed": "{{seed}}",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["98", 0],
      "negative": ["98", 1],
      "latent_image": ["86", 0],
      "start_at_step": 2,
      "end_at_step": 4,
      "return_with_leftover_noise": "disable"
    }
  },
  "87": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["85", 0],
      "vae": ["90", 0]
    }
  },
  "117": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["87", 0],
      "fps": "{{fps}}"
    }
  },
  "118": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["117", 0],
      "filename_prefix": "{{filename_prefix}}",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
