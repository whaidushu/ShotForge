      "risks": {
        "action": "May over-specify movement and reduce visual freedom.",
        "emotion": "May exaggerate performance and reduce subtlety.",
        "character": "May add constraints that conflict with style.",
        "scene": "May over-constrain spatial layout.",
        "camera": "May reduce generator flexibility.",
        "audio": "May overfit timing before real audio exists.",
        "prompt": "May make prompts longer and harder to execute.",
        "default": "May introduce unintended changes."
      }
    },
    "correction": {
      "action": {
        "note": "Strengthen the action beat with a clearer before/after movement cue.",
        "motion": "Make the subject motion more readable, with a concrete gesture, direction, and visible reaction.",
        "prompt": "Emphasize explicit action staging, readable silhouettes, and a decisive visual anchor.",
        "effect": "Action intent should become easier to evaluate and less ambiguous."
      },
      "emotion": {
        "scene": "Increase the emotional objective so the beat has a clearer feeling change.",
        "shot": "Add visible expression, posture, or reaction detail that makes the intended emotion measurable.",
        "prompt": "Specify emotional performance cues and reaction timing without changing the core scene.",
        "effect": "Emotional intensity should become more legible in the generated result."
      },
      "prompt": {
        "prompt": "Clarify executable prompt constraints: subject, action, camera, timing, and success criteria.",
        "effect": "Prompt execution should become more constrained and easier to score."
      },
      "character": {
        "behavior": "Keep the character identity, silhouette, and behavioral intent consistent across the affected shots.",
        "prompt": "Preserve the same character identity, wardrobe logic, silhouette, and behavior continuity.",
        "effect": "Character continuity should become easier to track across the sequence."
      },
      "scene": {
        "scene": "Clarify spatial layout, foreground/background relationship, and scene anchor.",
        "shot": "Add a readable environment anchor so the shot location remains stable.",
        "prompt": "Specify the location anchor, spatial layers, and stable environmental details.",
        "effect": "Scene continuity and spatial readability should improve."
      },
      "camera": {
        "camera": "Tie camera movement directly to the narrative focal point.",
        "prompt": "Describe camera framing, lens distance, and the visual reason for the movement.",
        "effect": "Camera language should support the story beat more clearly."
      },
      "audio": {
        "sound": "Place a clear audio cue on the visual beat that needs emphasis.",
        "prompt": "Sync the key visual beat with a concrete sound cue or music change.",
        "effect": "Audio timing should become easier to align with the visual rhythm."
      }
    }
