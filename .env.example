# ShotForge local POC configuration

SHOTFORGE_APP_NAME=ShotForge
SHOTFORGE_STORAGE_ROOT=data
SHOTFORGE_RUNS_DIR=data/runs
SHOTFORGE_VERSIONS_DIR=data/versions
SHOTFORGE_KNOWLEDGE_BASE_PATH=data/knowledge_base.json
SHOTFORGE_MEMORY_STORE_PATH=data/memory.jsonl
SHOTFORGE_DEFAULT_DURATION_SECONDS=24

# Optional provider credentials are intentionally not required for the POC.
# Keep real secrets in .env, never in this file.
