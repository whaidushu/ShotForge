# ShotForge local configuration example

SHOTFORGE_APP_NAME=ShotForge
SHOTFORGE_STORAGE_ROOT=data
SHOTFORGE_RUNS_DIR=data/runs
SHOTFORGE_VERSIONS_DIR=data/versions
SHOTFORGE_KNOWLEDGE_BASE_PATH=data/knowledge_base.json
SHOTFORGE_MEMORY_STORE_PATH=data/memory.jsonl
SHOTFORGE_DEFAULT_DURATION_SECONDS=24

# Optional real LLM configuration. Keep defaults for fully local test mode.
# For an OpenAI-compatible endpoint:
# SHOTFORGE_LLM_PROVIDER=openai-compatible
# SHOTFORGE_LLM_MODEL=<model-name>
# SHOTFORGE_LLM_BASE_URL=https://api.example.com/v1
# SHOTFORGE_LLM_API_KEY=<api-key>
# SHOTFORGE_LLM_TEMPERATURE=0.2
# SHOTFORGE_EVALUATOR_MODE=hybrid

# Local LLM alternatives:
# Local OpenAI-compatible server:
# SHOTFORGE_LLM_PROVIDER=<local-provider-id>
# SHOTFORGE_LLM_MODEL=<model-name>
# SHOTFORGE_LLM_BASE_URL=http://<host>:<port>/v1
# SHOTFORGE_EVALUATOR_MODE=hybrid
#
# Alternative local gateway:
# SHOTFORGE_LLM_PROVIDER=<gateway-provider-id>
# SHOTFORGE_LLM_MODEL=<model-name>
# SHOTFORGE_LLM_BASE_URL=http://<host>:<port>/v1
# SHOTFORGE_LLM_API_KEY=<local-or-empty-key>
# SHOTFORGE_EVALUATOR_MODE=hybrid

# Local video generation service.
# SHOTFORGE_COMFYUI_ENABLED=true
# SHOTFORGE_COMFYUI_BASE_URL=http://<host>:<port>
# SHOTFORGE_COMFYUI_WORKFLOWS_DIR=<path-to-api-workflows>
# SHOTFORGE_COMFYUI_WORKFLOW_ID=<workflow-id>
# SHOTFORGE_COMFYUI_WIDTH=320
# SHOTFORGE_COMFYUI_HEIGHT=320
# SHOTFORGE_COMFYUI_LENGTH=9
# SHOTFORGE_COMFYUI_FPS=8
# SHOTFORGE_COMFYUI_TIMEOUT_SECONDS=1200
# 1 limits local smoke tests to one shot; 0 or unset generates every storyboard shot.
# SHOTFORGE_COMFYUI_MAX_SHOTS=1
# Optional folder used to detect local Wan VAE filename variants.
# SHOTFORGE_COMFYUI_VAE_DIR=<path-to-comfyui-models-vae>

# Visual observation / VLM evaluation. prompt-proxy is a local test fallback that
# reads prompt text instead of inspecting rendered frames.
# SHOTFORGE_OBSERVER_PROVIDER=prompt-proxy
# SHOTFORGE_VLM_FRAME_SAMPLE_COUNT=4
# SHOTFORGE_VLM_CONFIDENCE_THRESHOLD=0.65
# SHOTFORGE_VLM_REQUIRE_JSON=true
#
# Local vision example:
# SHOTFORGE_OBSERVER_PROVIDER=<local-vision-provider-id>
# SHOTFORGE_VLM_MODEL=<vision-model-name>
# SHOTFORGE_VLM_BASE_URL=http://<host>:<port>
#
# OpenAI-compatible VLM example:
# SHOTFORGE_OBSERVER_PROVIDER=<openai-compatible-vision-provider-id>
# SHOTFORGE_VLM_MODEL=<vision-model-name>
# SHOTFORGE_VLM_BASE_URL=http://<host>:<port>/v1
# SHOTFORGE_VLM_API_KEY=<local-or-api-key>

# Optional provider credentials are intentionally not required for the default local setup.
# Keep real secrets in .env, never in this file.
