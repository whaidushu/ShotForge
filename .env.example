# ShotForge local POC configuration

SHOTFORGE_APP_NAME=ShotForge
SHOTFORGE_STORAGE_ROOT=data
SHOTFORGE_RUNS_DIR=data/runs
SHOTFORGE_VERSIONS_DIR=data/versions
SHOTFORGE_KNOWLEDGE_BASE_PATH=data/knowledge_base.json
SHOTFORGE_MEMORY_STORE_PATH=data/memory.jsonl
SHOTFORGE_DEFAULT_DURATION_SECONDS=24

# Optional real LLM configuration. Keep defaults for fully local mock mode.
# For OpenAI, Doubao, DeepSeek, Qwen, or another OpenAI-compatible endpoint:
# SHOTFORGE_LLM_PROVIDER=openai-compatible
# SHOTFORGE_LLM_MODEL=your-model-name
# SHOTFORGE_LLM_BASE_URL=https://api.example.com/v1
# SHOTFORGE_LLM_API_KEY=your-api-key
# SHOTFORGE_LLM_TEMPERATURE=0.2
# SHOTFORGE_EVALUATOR_MODE=hybrid

# Local LLM alternatives:
# Ollama:
# SHOTFORGE_LLM_PROVIDER=ollama
# SHOTFORGE_LLM_MODEL=qwen2.5:7b
# SHOTFORGE_LLM_BASE_URL=http://localhost:11434/v1
# SHOTFORGE_EVALUATOR_MODE=hybrid
#
# vLLM OpenAI-compatible server:
# SHOTFORGE_LLM_PROVIDER=vllm
# SHOTFORGE_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# SHOTFORGE_LLM_BASE_URL=http://127.0.0.1:8000/v1
# SHOTFORGE_LLM_API_KEY=local
# SHOTFORGE_EVALUATOR_MODE=hybrid

# Local ComfyUI video generation. The ComfyUI desktop app often runs on 8001;
# standalone ComfyUI usually runs on 8188.
# SHOTFORGE_COMFYUI_ENABLED=true
# SHOTFORGE_COMFYUI_BASE_URL=http://127.0.0.1:8001
# SHOTFORGE_COMFYUI_WORKFLOWS_DIR=C:\Users\your-name\Documents\ComfyUI\user\default\workflows
# SHOTFORGE_COMFYUI_WORKFLOW_ID=wan2_2_i2v_empty_start
# SHOTFORGE_COMFYUI_WIDTH=320
# SHOTFORGE_COMFYUI_HEIGHT=320
# SHOTFORGE_COMFYUI_LENGTH=9
# SHOTFORGE_COMFYUI_FPS=8
# SHOTFORGE_COMFYUI_TIMEOUT_SECONDS=1200
# 1 limits local smoke tests to one shot; 0 or unset generates every storyboard shot.
# SHOTFORGE_COMFYUI_MAX_SHOTS=1

# Visual observation / VLM evaluation. prompt-proxy is a local test fallback that
# reads prompt text instead of inspecting rendered frames.
# SHOTFORGE_OBSERVER_PROVIDER=prompt-proxy
# SHOTFORGE_VLM_FRAME_SAMPLE_COUNT=4
# SHOTFORGE_VLM_CONFIDENCE_THRESHOLD=0.65
# SHOTFORGE_VLM_REQUIRE_JSON=true
#
# Ollama vision example:
# SHOTFORGE_OBSERVER_PROVIDER=ollama-vision
# SHOTFORGE_VLM_MODEL=qwen2.5vl:7b
# SHOTFORGE_VLM_BASE_URL=http://localhost:11434
#
# vLLM VLM example:
# SHOTFORGE_OBSERVER_PROVIDER=vllm-vlm
# SHOTFORGE_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# SHOTFORGE_VLM_BASE_URL=http://127.0.0.1:8000/v1
# SHOTFORGE_VLM_API_KEY=local

# Optional provider credentials are intentionally not required for the POC.
# Keep real secrets in .env, never in this file.
